<!-- Footer -->
<footer class="border-t border-slate-200 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">

    <!-- Main Grid: Logo left, Links+Contact right -->
    <div class="flex flex-col md:flex-row md:justify-between gap-10">

      <!-- Logo & Tagline -->
      <div class="md:max-w-xs">
        <img src="/assets/logo-small.webp" alt="Samplify logo" class="h-9 w-auto"/>
        <p class="mt-4 text-sm text-slate-600 leading-relaxed">
          Advanced medical sample logistics solutions engineered in Saudi Arabia for Vision 2030.
        </p>
      </div>

      <!-- Quick Links + Contact -->
      <div class="grid grid-cols-2 gap-10 lg:gap-16">

        <!-- Quick Links -->
        <div>
          <h3 class="font-semibold text-deepblue-900">Quick Links</h3>
          <ul class="mt-4 space-y-3 text-sm">
            {% for link in footer.quickLinks %}
            <li><a class="text-slate-600 hover:text-deepblue-900 hover:underline transition" href="{{ link.url }}">{{ link.label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h3 class="font-semibold text-deepblue-900">Contact</h3>
          <ul class="mt-4 space-y-3 text-sm">
            {% for link in footer.contactLinks %}
            <li><a class="text-slate-600 hover:text-deepblue-900 hover:underline transition" href="{{ link.url }}"{% if link.target %} target="{{ link.target }}"{% endif %}{% if link.rel %} rel="{{ link.rel }}"{% endif %}>{{ link.label }}</a></li>
            {% endfor %}
            <li class="pt-1">
              <span class="text-slate-500">Riyadh, Kingdom of Saudi Arabia</span>
            </li>
          </ul>
        </div>

      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-slate-500">
      <span>© <span id="year"></span> Samplify. All rights reserved.</span>
      <span>Powered by <a href="https://bayanata.com" target="_blank" rel="noopener" class="text-slate-600 hover:text-deepblue-900 hover:underline transition">Bayanata</a>.</span>
    </div>
  </div>
</footer>

<!-- Toast Container -->
<div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>
