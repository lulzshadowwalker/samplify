---
title: Gallery — Samplify Medical Logistics
description: "See Samplify's medical sample logistics technology: devices, RFID systems, software, and workflows in action."
ogTitle: Samplify Gallery — Medical Logistics Technology in Action
ogDescription: Visual showcase of Samplify's advanced medical sample logistics solutions, featuring smart devices, RFID-enabled racks, and software platforms.
---

{% extends "layouts/base.njk" %}

{% block meta %}
  <link rel="canonical" href="https://samplify.net/gallery"/>
  <meta name="keywords" content="medical sample logistics, technology, gallery, RFID, devices, software, workflows"/>
{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Samplify Technology Gallery",
  "description": "Showcase of Samplify's medical sample logistics technology, including devices, RFID systems, software interfaces, and workflows."
}
</script>
{% endblock %}

{% block content %}
<!-- Hero Section -->
<section class="relative isolate overflow-hidden bg-gradient-to-b from-skybrand-300 via-skybrand-500 to-deepblue-900 py-16 sm:py-20">
  <div class="absolute inset-0 -z-10 opacity-20">
    <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 800 600" class="h-full w-full">
      <defs>
        <linearGradient id="g" x1="0" x2="1" y1="0" y2="1">
          <stop stop-color="#ffffff" stop-opacity="0.3" offset="0"/>
          <stop stop-color="#87CEEB" stop-opacity="0.2" offset="1"/>
        </linearGradient>
      </defs>
      <g fill="url(#g)">
        <circle cx="120" cy="140" r="60"/>
        <rect x="520" y="100" width="180" height="120" rx="12"/>
        <circle cx="650" cy="420" r="70"/>
        <rect x="80" y="350" width="140" height="100" rx="12"/>
      </g>
    </svg>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    <div class="reveal">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">Technology Gallery</h1>
      <p class="mt-6 text-lg sm:text-xl text-white/90 max-w-3xl mx-auto">
        Explore our innovative medical sample logistics solutions in action. 
        Discover the technology that's transforming healthcare logistics across the Middle East.
      </p>
    </div>
  </div>
</section>

<!-- Process Workflows -->
<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 reveal">
      <h2 class="text-2xl sm:text-3xl font-bold text-deepblue-900">Operational Workflows</h2>
      <p class="mt-3 text-slate-600">
        See how our integrated solution streamlines medical sample logistics from collection to delivery
      </p>
    </div>
    
    <div class="max-w-4xl mx-auto reveal">
      <div class="relative overflow-hidden rounded-2xl bg-slate-100 shadow-xl">
        <div class="aspect-video">
          <video 
            class="w-full h-full object-cover" 
            controls
            playsinline
            data-lightbox="workflows"
            data-caption="Samplify Operational Process"
          >
            <source src="/assets/videos/process.mp4" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
      <h3 class="text-xl font-semibold text-deepblue-900 mt-4 text-center">Operational Process</h3>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-gradient-to-r from-skybrand-300 to-skybrand-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    <div class="reveal">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6">See Samplify in Action</h2>
      <p class="text-lg text-white/90 max-w-2xl mx-auto mb-8">
        Ready to experience how our technology can transform your medical sample logistics? 
        Schedule a personalized demonstration with our team.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" data-demo="true" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white text-deepblue-900 font-medium hover:shadow-lg hover:-translate-y-0.5 transition focus-ring">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 5v5l4 2-.75 1.23L11 12V7h2z"/>
          </svg>
          Request Live Demo
        </a>
        <a href="/solutions" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl border border-white/70 text-white hover:bg-white/10 transition focus-ring">
          Explore Solutions
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block scripts %}
<!-- Video.js (for Lightbox video playback) -->
<link rel="stylesheet" href="https://vjs.zencdn.net/8.16.1/video-js.css"/>
<script src="https://vjs.zencdn.net/8.16.1/video.min.js"></script>
{% endblock %}
